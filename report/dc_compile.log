foreach detail_report [list     ${check_design_report}     ${check_timing_report}     ${area_report}     ${setup_timing_report}     ${hold_timing_report}     ${constraints_report}     ${clocks_report}     ${design_report}     ${objects_report}] {
    echo "  [file tail ${detail_report}]" >> "${summary_report}"
